# MySQL přístupové údaje
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=vase_heslo
DB_NAME=jmeno_vasi_databaze

# Složka pro lokální vektorovou databázi.
# DŮLEŽITÉ: Ukazuje do složky chat-api/chroma_db, aby chatbot data přímo četl.
# Při změně cesty aktualizujte i CHROMA_DB_DIR v souboru chat-api/.env!
# Lokální vývoj (bez Dockeru): ../chat-api/chroma_db
# Docker Compose: ./chroma_db  (namapováno na stejný named volume jako chat-api)
CHROMA_DB_DIR=../chat-api/chroma_db

# Název kolekce v ChromaDB – musí být IDENTICKÝ s hodnotou v chat-api/.env!
CHROMA_COLLECTION=chatbot_data

# Embedding model – musí být IDENTICKÝ s hodnotou v chat-api/.env!
# Záměna modelu způsobí nekompatibilní vektory a nesmyslné výsledky vyhledávání.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
