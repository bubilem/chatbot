# =============================================
# Chatbot API – konfigurační šablona
# Zkopírujte tento soubor na ".env" a vyplňte hodnoty.
# SOUBOR .env NESMÍ BÝT NIKDY COMMITOVÁN DO GITU!
# =============================================

# --- Vektorová databáze ---
# Cesta ke složce chroma_db/ (relativní od chat-api/).
# Data-vectorizer musí mít CHROMA_DB_DIR nastaven na stejnou absolutní cestu
# nebo na ../chat-api/chroma_db (relativní od data-vectorizer/).
CHROMA_DB_DIR=./chroma_db

# Název kolekce v ChromaDB (musí být stejný jako v data-vectorizer/load.py)
CHROMA_COLLECTION=chatbot_data

# --- Embedding model ---
# Musí být IDENTICKÝ s modelem použitým při vektorizaci v data-vectorizer!
# Záměna modelu způsobí nekompatibilní vektory a nesmyslné výsledky vyhledávání.
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --- Ollama (lokální LLM) ---
# URL adresa běžícího Ollama serveru
OLLAMA_BASE_URL=http://localhost:11434

# Název modelu v Ollama (spusťte "ollama pull llama3.2" pro stažení)
# Doporučené modely pro češtinu: llama3.2, mistral, gemma2
OLLAMA_MODEL=llama3.2

# --- RAG parametry ---
# Počet nejrelevantnějších chunků předaných LLM jako kontext (doporučeno 3–5)
RETRIEVAL_TOP_K=3
